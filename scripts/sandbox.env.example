# Copy to  scripts/sandbox.env  (gitignored) and fill in. Every value the
# configure script needs is here — nothing is hardcoded in the script itself.
#
#   cp scripts/sandbox.env.example scripts/sandbox.env
#   # edit scripts/sandbox.env
#   ./scripts/configure-azure-sandbox.sh
#
# Keep real secrets only in your local sandbox.env, never in the .example.

# ---- Azure resources -------------------------------------------------------
# Optional: only needed if your az CLI default subscription is not the right one.
export SUBSCRIPTION=""
export RG="rg-ap-automations-sbx"
export FUNCTION_APP="advisory-partners-automations-sbx"
export KEY_VAULT="kv-ap-automations-sbx"          # confirm the real vault name

# ---- Zoho (non-secret) -----------------------------------------------------
export ZOHO_PORTAL_ID="aiautomation"
export ZOHO_CLIENT_ID="1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
export ZOHO_ACCOUNTS_URL="https://accounts.zoho.com"
# Must be a real https URL AND registered in the Zoho API console as an
# authorized redirect. Typically https://<app-default-hostname>/callback
export ZOHO_REDIRECT_URI="https://advisory-partners-automations-sbx-xxxx.australiaeast-01.azurewebsites.net/callback"

# ---- Zoho (secret) — do NOT commit a real value ----------------------------
export ZOHO_CLIENT_SECRET=""

# ---- Power Automate --------------------------------------------------------
# The webhook URL's sig= is a secret; treat the whole URL as sensitive.
export POWER_AUTOMATE_WEBHOOK_URL=""
export POWER_AUTOMATE_ALLOWED_HOSTS=""

# ---- App config ------------------------------------------------------------
# Comma-separated allowed origins for CORS (your frontend origin(s)).
export CORS_ALLOW_ORIGINS="https://advisory-partners-automations-sbx-xxxx.australiaeast-01.azurewebsites.net"
# Name of the Key Vault secret holding the Zoho token bundle.
export ZOHO_TOKENS_SECRET_NAME="zoho-tokens"
